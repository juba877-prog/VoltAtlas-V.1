<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar" />

    <!-- Native Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Solid opaque dark navy background -->
        <item name="windowSplashScreenBackground">#07101F</item>
        <!-- Center the VA monogram -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/voltatlas_va_logo</item>
        <!-- Smooth post-splash transition back to main theme -->
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>
